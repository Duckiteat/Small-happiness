{
  "format_version": 1,
  "file_kind": "objects",
  "why": "첫 주 슬라이스: 음식 종류와 냉장고 속 음식 10가지. 시들고 상하기까지의 날짜는 냉장·개봉 기준의 일상적 대략값이며 확인하지 않은 임시값(tuned:false)이다. 종류의 규칙(냄새)과 행동(버리기)은 모두 물려받는다.",
  "defs": [
    {
      "id": "OBJ+1",
      "names": {
        "ko": "음식",
        "en": "food"
      },
      "aliases": [
        "식재료",
        "먹을거리"
      ],
      "mobility": "가변",
      "slots": {
        "body": {
          "features": [
            "rot",
            "smell"
          ]
        }
      },
      "meanings": [
        {
          "label": "먹을 수 있음",
          "when": [
            "body:rot@<=wilted"
          ],
          "means": "edible"
        },
        {
          "label": "먹을 수 없음",
          "when": [],
          "means": "inedible"
        }
      ],
      "rules": {
        "wilt": {
          "label": "신선한 음식이 시든다",
          "on": [
            "OBJ+1|body:rot@=fresh"
          ],
          "emits": [
            "OBJ+1|body:rot@=wilted"
          ],
          "delay_s": 259200,
          "tuned": false
        },
        "go_bad": {
          "label": "시든 음식이 상한다",
          "on": [
            "OBJ+1|body:rot@=wilted"
          ],
          "emits": [
            "OBJ+1|body:rot@=spoiled"
          ],
          "delay_s": 172800,
          "tuned": false
        },
        "spoil": {
          "label": "상하면 냄새가 뚜렷해진다",
          "on": [
            "OBJ+1|body:rot@>=spoiled"
          ],
          "emits": [
            "OBJ+1|body:smell@>=distinct"
          ],
          "delay_s": 21600,
          "tuned": false
        }
      },
      "offers": {
        "discard": {
          "label": "상한 음식을 버린다",
          "verb": "discard",
          "needs": [
            {
              "aware": "OBJ+1|body:rot",
              "at_least": "understood"
            }
          ],
          "when": [
            "OBJ+1|body:rot@>=spoiled"
          ],
          "effect": [
            "OBJ+1|body:rot@=gone",
            "OBJ+1|body:smell@=gone"
          ],
          "minutes": 2,
          "tuned": false
        }
      },
      "desc": [
        "음식의 종류. 직접 두지 않고 개별 음식이 물려받는다. 기본은 뚜껑을 딴 냉장 음식(우유 기준)."
      ]
    },
