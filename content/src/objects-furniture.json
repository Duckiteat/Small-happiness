    {
      "id": "OBJ000017",
      "names": {
        "ko": "전기밥솥",
        "en": "rice cooker"
      },
      "mobility": "portable",
      "role": "device",
      "utility": [
        "electric"
      ],
      "holds": [
        "water"
      ],
      "slots": {
        "pot": {
          "features": [
            "water",
            "power",
            "rice"
          ]
        }
      },
      "initial": {
        "pot:water": "none",
        "pot:power": "off",
        "pot:rice": "raw"
      },
      "rules": {
        "cook_rice": {
          "label": "물을 담고 켜 두면 30분 뒤 밥이 되고, 물은 밥에 흡수되고, 스스로 꺼진다",
          "on": [
            "OBJ000017|pot:power@=on",
            "OBJ000017|pot:water@>=some"
          ],
          "emits": [
            "OBJ000017|pot:rice@>=cooked",
            "OBJ000017|pot:water@<=none",
            "OBJ000017|pot:power@<=off"
          ],
          "delay_s": 1800,
          "tuned": false
        }
      },
      "offers": {
        "pour": {
          "label": "싱크대에 받은 물을 밥솥에 붓는다",
          "verb": "fill",
          "needs": [],
          "when": [
            "OBJ000017|pot:water@=none",
            "OBJ000020|basin:water@>=some"
          ],
          "during": [
            "meal"
          ],
          "effect": [
            "OBJ000017|pot:water@=full",
            "OBJ000020|basin:water@=none"
          ],
          "minutes": 2,
          "tuned": false
        },
        "start": {
          "label": "물을 담은 밥솥을 켠다",
          "verb": "switch",
          "needs": [],
          "when": [
            "OBJ000017|pot:water@>=some",
            "OBJ000017|pot:power@=off",
            "OBJ000017|pot:rice@=raw"
          ],
          "during": [
            "meal"
          ],
          "effect": [
            "OBJ000017|pot:power@=on"
          ],
          "minutes": 1,
          "tuned": false
        }
      }
    },
    {
      "id": "OBJ000018",
      "names": {
        "ko": "후드",
        "en": "range hood"
      },
      "mobility": "fixed",
      "role": "device",
      "utility": [
        "electric"
      ],
      "slots": {
        "fan": {
          "features": [
            "power"
          ]
        }
      },
      "initial": {
        "fan:power": "off"
      },
      "rules": {
        "vent": {
          "label": "후드를 켜 두면 주방의 짙은 냄새가 10분 안에 옅어진다",
          "on": [
            "OBJ000018|fan:power@=on",
            "PLC000002|space:smell@>=distinct"
          ],
          "emits": [
            "PLC000002|space:smell@<=faint"
          ],
          "delay_s": 600,
          "tuned": false
        },
        "auto_off": {
          "label": "후드는 켠 지 한 시간이면 스스로 꺼진다",
          "on": [
            "OBJ000018|fan:power@=on"
          ],
          "emits": [
            "OBJ000018|fan:power@<=off"
          ],
          "delay_s": 3600,
          "tuned": false
        }
      },
      "offers": {
        "run": {
          "label": "주방 냄새가 짙으면 후드를 켠다",
          "verb": "switch",
          "needs": [],
          "when": [
            "PLC000002|space:smell@>=distinct",
            "OBJ000018|fan:power@=off"
          ],
          "during": [
            "meal"
          ],
          "effect": [
            "OBJ000018|fan:power@=on"
          ],
          "minutes": 1,
          "tuned": false
        }
      }
    },
