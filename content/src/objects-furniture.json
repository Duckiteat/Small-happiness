      "rules": {
        "drain": {
          "label": "싱크대에 남은 물은 한 시간 뒤 배수구로 빠진다",
          "on": [
            "OBJ000020|basin:water@>=some"
          ],
          "emits": [
            "OBJ000020|basin:water@<=none"
          ],
          "delay_s": 3600,
          "tuned": false
        }
      },
      "offers": {
        "draw": {
          "label": "수도를 틀어 싱크대에 물을 받는다",
          "verb": "fill",
          "needs": [],
          "when": [
            "OBJ000020|basin:water@=none",
            "OBJ000017|pot:water@=none",
            "OBJ000017|pot:rice@=raw"
          ],
          "during": [
            "meal"
          ],
          "effect": [
            "OBJ000020|basin:water@=full"
          ],
          "minutes": 2,
          "tuned": false
        }
      }
    },
    {
