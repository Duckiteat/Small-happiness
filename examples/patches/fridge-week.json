{
  "format": "small-happiness-patch",
  "version": 1,
  "why": "세계 실행기 시연: 냉장고의 음식이 시간에 따라 상하고, 냄새와 벌레가 주방에서 거실로 번진다. 지연 시간은 모두 임시값(tuned:false)이다",
  "defs": [
    {
      "id": "OBJ+1",
      "names": { "ko": "음식", "en": "food" },
      "mobility": "portable",
      "slots": { "body": { "features": ["rot", "smell"] } },
      "rules": {
        "wilt": { "label": "시간이 지나면 시든다", "on": ["OBJ+1|body:rot@=fresh"], "emits": ["OBJ+1|body:rot@>=wilted"], "delay_s": 172800, "tuned": false },
        "spoil": { "label": "시든 채로 두면 상한다", "on": ["OBJ+1|body:rot@=wilted"], "emits": ["OBJ+1|body:rot@>=spoiled"], "delay_s": 172800, "tuned": false },
        "rot": { "label": "상한 채로 두면 썩는다", "on": ["OBJ+1|body:rot@=spoiled"], "emits": ["OBJ+1|body:rot@>=rotten"], "delay_s": 172800, "tuned": false },
        "reek": { "label": "상하면 냄새가 뚜렷해진다", "on": ["OBJ+1|body:rot@>=spoiled"], "emits": ["OBJ+1|body:smell@>=distinct"], "delay_s": 28800, "tuned": false },
        "stink": { "label": "썩으면 악취가 난다", "on": ["OBJ+1|body:rot@>=rotten"], "emits": ["OBJ+1|body:smell@>=foul"], "delay_s": 28800, "tuned": false }
      }
    },
    {
      "id": "PLC+1",
      "names": { "ko": "주방", "en": "kitchen" },
      "slots": { "space": { "features": ["smell", "bug"] } },
      "rules": {
        "odor_reach": { "label": "음식 냄새가 주방에 퍼진다", "on": ["OBJ+1|body:smell@>=distinct"], "emits": ["PLC+1|space:smell@>=faint"], "delay_s": 3600, "tuned": false },
        "odor_thick": { "label": "악취가 주방에 뚜렷하게 밴다", "on": ["OBJ+1|body:smell@>=foul"], "emits": ["PLC+1|space:smell@>=distinct"], "delay_s": 21600, "tuned": false },
        "bugs": { "label": "냄새가 뚜렷하면 벌레가 꼬인다", "on": ["PLC+1|space:smell@>=distinct"], "emits": ["PLC+1|space:bug@>=few"], "delay_s": 43200, "tuned": false },
        "spread": { "label": "벌레가 거실로 번진다", "on": ["PLC+1|space:bug@>=few"], "emits": ["PLC+2|space:bug@>=few"], "delay_s": 86400, "tuned": false }
      }
    },
    {
      "id": "PLC+2",
      "names": { "ko": "거실", "en": "living room" },
      "slots": { "space": { "features": ["bug"] } }
    }
  ]
}
