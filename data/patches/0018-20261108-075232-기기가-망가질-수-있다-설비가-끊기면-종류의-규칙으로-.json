        },
        "names": {
          "ko": "전기밥솥",
          "en": "rice cooker"
        },
        "is_a": "OBJ000022",
        "rules": {
          "cook_rice": {
            "label": "물을 담고 켜 두면 30분 뒤 밥이 되고, 물은 밥에 흡수되고, 스스로 꺼진다",
            "on": [
              "OBJ000017|pot:power@=on",
              "OBJ000017|pot:water@>=some",
              "OBJ000017|body:order@=ok"
            ],
            "emits": [
              "OBJ000017|pot:rice@>=cooked",
              "OBJ000017|pot:water@<=none",
              "OBJ000017|pot:power@<=off"
            ],
            "delay_s": 1800,
            "tuned": false
          },
          "dies": {
            "label": "망가지면 꺼진다",
            "on": [
              "OBJ000017|body:order@=broken"
            ],
            "emits": [
              "OBJ000017|pot:power@<=off"
            ]
          }
        },
        "offers": {
          "pour": {
            "label": "싱크대에 받은 물을 밥솥에 붓는다",
            "verb": "fill",
            "needs": [],
            "when": [
              "OBJ000017|pot:water@=none",
              "OBJ000020|basin:water@>=some",
              "OBJ000017|body:order@=ok"
            ],
            "during": [
              "meal"
            ],
            "effect": [
              "OBJ000017|pot:water@=full",
              "OBJ000020|basin:water@=none"
            ],
            "minutes": 2,
            "tuned": false
          },
          "start": {
            "label": "물을 담은 밥솥을 켠다",
            "verb": "switch",
            "needs": [],
            "when": [
              "OBJ000017|pot:water@>=some",
              "OBJ000017|pot:power@=off",
              "OBJ000017|pot:rice@=raw",
              "OBJ000017|body:order@=ok"
            ],
            "during": [
              "meal"
            ],
            "effect": [
              "OBJ000017|pot:power@=on"
            ],
            "minutes": 1,
            "tuned": false
          }
        },
        "initial": {
          "pot:water": "none",
          "pot:power": "off",
          "pot:rice": "raw"
        }
