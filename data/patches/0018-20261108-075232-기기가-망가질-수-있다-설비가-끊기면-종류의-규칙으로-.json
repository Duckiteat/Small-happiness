              "OBJ000018|body:order@=ok"
            ],
            "during": [
              "meal"
            ],
            "effect": [
              "OBJ000018|fan:power@=on"
            ],
            "minutes": 1,
            "tuned": false
          }
        },
        "initial": {
          "fan:power": "off"
        }
