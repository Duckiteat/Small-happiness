              "OBJ000017|pot:water@=none",
              "OBJ000020|basin:water@>=some"
            ],
            "during": [
              "meal"
            ],
            "effect": [
              "OBJ000017|pot:water@=full",
              "OBJ000020|basin:water@=none"
            ],
            "minutes": 2,
            "tuned": false
          },
          "start": {
            "label": "물을 담은 밥솥을 켠다",
            "verb": "switch",
            "needs": [],
            "when": [
              "OBJ000017|pot:water@>=some",
              "OBJ000017|pot:power@=off",
              "OBJ000017|pot:rice@=raw"
