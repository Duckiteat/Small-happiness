{
  "patch": {
    "format": "small-happiness-patch",
    "version": 1,
    "why": "주방의 설비 공급 상태(grid): 정전·단수·가스 끊김과, 끊겨도 두 시간 뒤 스스로 돌아오는 규칙. 나머지는 그대로다. 수치는 임시값. / 기기의 종류(전기·가스·수도 기기): 쓰는 설비가 끊기면 망가지고, 설비가 다시 들어오면 고칠 수 있다. 개별 기기는 이 종류에서 물려받는다.",
    "defs": [
      {
        "id": "PLC000001",
        "names": {
          "ko": "현관",
          "en": "entrance"
        },
        "environment": {
          "weather_effect": "mid",
          "temp_swing": "mid",
          "ventilation": "low",
          "humidity": "low"
        },
        "passages": [
          {
            "to": "PLC000002",
            "kind": "open",
            "medium_pass": {
              "air": 1000,
              "self_move": 1000
            },
            "tuned": false
          }
        ],
        "slots": {
          "space": {
            "features": [
              "smell"
            ]
          }
        },
        "desc": [
          "하루의 시작과 끝. 복도에 면한다 (세계-설정 2장)"
        ]
      },
      {
        "id": "PLC000002",
        "names": {
          "ko": "주방",
          "en": "kitchen"
        },
        "aliases": [
          "부엌"
        ],
        "environment": {
          "weather_effect": "low",
          "temp_swing": "low",
          "ventilation": "low",
          "humidity": "mid"
        },
        "passages": [
          {
            "to": "PLC000003",
            "kind": "door",
            "medium_pass": {
              "air": 100,
              "self_move": 0
            },
            "tuned": false
          },
          {
            "to": "PLC000004",
            "kind": "door",
            "medium_pass": {
              "air": 100,
              "self_move": 0
            },
            "tuned": false
          }
        ],
        "slots": {
          "space": {
            "features": [
              "smell",
              "odor",
              "bug"
            ]
          },
          "grid": {
            "features": [
              "grid_electric",
              "grid_water",
              "grid_gas"
            ]
          }
        },
        "rules": {
          "odor_reach": {
            "label": "상한 음식의 냄새가 주방에 퍼진다",
            "on": [
              "OBJ000001|body:smell@>=distinct"
            ],
            "emits": [
              "PLC000002|space:smell@>=faint"
            ]
          },
          "odor_thicken": {
            "label": "냄새나는 음식이 남아 있으면 주방 냄새가 짙어진다",
            "on": [
              "OBJ000001|body:smell@>=distinct",
              "PLC000002|space:smell@=faint"
            ],
            "emits": [
              "PLC000002|space:smell@>=distinct"
            ],
            "delay_s": 10800,
            "tuned": false
          },
          "air_out": {
            "label": "냄새나는 음식이 하나도 없으면 주방 냄새가 빠진다",
            "on": [
              "PLC000002|space:smell@>=faint"
            ],
            "emits": [
              "PLC000002|space:smell@<=none"
            ],
            "on_all": [
              "OBJ000001|body:smell@<=faint"
            ],
            "delay_s": 10800,
            "tuned": false
          },
          "bugs": {
            "label": "상한 냄새(시큼함 이상)가 뚜렷하면 벌레가 꼬인다",
            "on": [
              "PLC000002|space:smell@>=distinct",
              "PLC000002|space:odor@>=sour"
            ],
            "emits": [
              "PLC000002|space:bug@=few"
            ],
            "delay_s": 28800,
            "tuned": false
          },
          "kind_sour": {
            "label": "음식 중 가장 심한 냄새가 시큼한 발효 냄새이고 주방에 냄새가 퍼지면 주방 냄새도 시큼한 발효 냄새가 된다",
            "on": [
              "OBJ000001|body:odor@>=sour",
              "PLC000002|space:smell@>=faint"
            ],
            "emits": [
              "PLC000002|space:odor@>=sour"
            ],
            "on_all": [
              "OBJ000001|body:odor@<=sour"
            ]
          },
          "kind_musty": {
            "label": "음식 중 가장 심한 냄새가 곰팡내이고 주방에 냄새가 퍼지면 주방 냄새도 곰팡내가 된다",
            "on": [
              "OBJ000001|body:odor@>=musty",
              "PLC000002|space:smell@>=faint"
            ],
            "emits": [
              "PLC000002|space:odor@>=musty"
            ],
            "on_all": [
              "OBJ000001|body:odor@<=musty"
            ]
          },
          "kind_sulfur": {
            "label": "음식 중 가장 심한 냄새가 황 냄새이고 주방에 냄새가 퍼지면 주방 냄새도 황 냄새가 된다",
            "on": [
              "OBJ000001|body:odor@>=sulfur",
              "PLC000002|space:smell@>=faint"
            ],
            "emits": [
              "PLC000002|space:odor@>=sulfur"
            ],
            "on_all": [
              "OBJ000001|body:odor@<=sulfur"
            ]
          },
          "kind_putrid": {
            "label": "음식 중 가장 심한 냄새가 썩는 냄새이고 주방에 냄새가 퍼지면 주방 냄새도 썩는 냄새가 된다",
            "on": [
              "OBJ000001|body:odor@>=putrid",
              "PLC000002|space:smell@>=faint"
            ],
            "emits": [
              "PLC000002|space:odor@>=putrid"
            ],
            "on_all": [
              "OBJ000001|body:odor@<=putrid"
            ]
          },
          "kind_clear": {
            "label": "주방 냄새가 가시면 냄새 종류도 사라진다",
            "on": [
              "PLC000002|space:smell@<=none"
            ],
            "emits": [
              "PLC000002|space:odor@<=none"
            ]
          },
          "restore_electric": {
            "label": "끊긴 electric 공급은 두 시간 뒤 돌아온다",
            "on": [
              "PLC000002|grid:grid_electric@=cut"
            ],
            "emits": [
              "PLC000002|grid:grid_electric@<=normal"
            ],
            "delay_s": 7200,
            "tuned": false
          },
          "restore_water": {
            "label": "끊긴 water 공급은 두 시간 뒤 돌아온다",
            "on": [
              "PLC000002|grid:grid_water@=cut"
            ],
            "emits": [
              "PLC000002|grid:grid_water@<=normal"
            ],
            "delay_s": 7200,
            "tuned": false
          },
          "restore_gas": {
            "label": "끊긴 gas 공급은 두 시간 뒤 돌아온다",
            "on": [
              "PLC000002|grid:grid_gas@=cut"
            ],
            "emits": [
              "PLC000002|grid:grid_gas@<=normal"
            ],
            "delay_s": 7200,
            "tuned": false
          }
        },
        "offers": {
          "inspect": {
            "label": "냄새가 어디서 나는지 주방과 냉장고를 살핀다 (구수한 요리 냄새는 살피지 않는다)",
            "verb": "inspect",
            "needs": [
              {
                "aware": "PLC000002|space:smell",
                "at_least": "noticed"
              }
            ],
            "effect": [],
            "reveals": true,
            "minutes": 5,
            "tuned": false,
            "when": [
              "PLC000002|space:odor@>=sour"
            ]
          }
        },
        "desc": [
          "현관을 열면 바로 있다. 냄새가 고인다. 냉장고의 자리 (세계-설정 2·3장)"
        ],
        "supplies": [
          "electric",
          "water",
          "gas"
        ]
