    "category": "action",
    "entries": [
      {
        "key": "slice",
        "ko": "썰기",
        "en": "slice",
        "aliases": [
          "칼질"
        ],
        "desc": "칼과 도마로 재료를 썬다. 재료의 가공이 오르고 칼과 도마가 더러워진다"
      },
      {
        "key": "add",
        "ko": "넣기",
        "en": "add",
        "desc": "재료를 냄비에 넣는다. 재료의 남은 양이 줄고 냄비의 국물·건더기가 바뀐다"
      },
      {
        "key": "wash",
        "ko": "설거지",
        "en": "wash",
        "aliases": [
          "씻기"
        ],
        "desc": "싱크대에 받은 물로 더러워진 도구를 씻는다. 물은 배수로 사라진다"
      },
      {
        "key": "eat",
        "ko": "먹기",
        "en": "eat",
        "desc": "만든 음식을 먹는다. 그릇이 비고 더러워진다"
      },
      {
        "key": "extinguish",
        "ko": "불 끄기",
        "en": "extinguish",
        "desc": "다 된 요리의 불을 끈다"
      },
      {
        "key": "transfer",
        "ko": "옮겨 담기",
        "en": "transfer",
        "aliases": [
          "덜기"
        ],
        "desc": "냄비의 음식을 다른 그릇에 옮겨 담는다. 담은 음식은 새 개체가 된다"
      },
      {
        "key": "take_out",
        "ko": "꺼내기",
        "en": "take out",
        "desc": "냉장고 같은 곳에서 물건을 꺼내 다른 곳에 둔다"
      }
    ]
  },
