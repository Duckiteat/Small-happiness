            "rot",
            "smell"
          ]
        }
      },
      "meanings": [
        {
          "label": "먹을 수 있음",
          "when": [
            "body:rot@<=wilted"
          ],
          "means": "edible"
        },
        {
          "label": "먹을 수 없음",
          "when": [],
          "means": "inedible"
        }
      ],
      "rules": {
        "go_bad": {
          "label": "시든 음식이 상한다",
          "on": [
            "OBJ000001|body:rot@=wilted"
          ],
          "emits": [
            "OBJ000001|body:rot@=spoiled"
          ],
          "delay_s": 172800,
          "tuned": false
        },
        "spoil": {
          "label": "상하면 냄새가 뚜렷해진다",
          "on": [
            "OBJ000001|body:rot@>=spoiled"
          ],
          "emits": [
            "OBJ000001|body:smell@>=distinct"
          ],
          "delay_s": 21600,
          "tuned": false
        },
        "wilt": {
          "label": "신선한 음식이 시든다",
          "on": [
            "OBJ000001|body:rot@=fresh"
          ],
          "emits": [
            "OBJ000001|body:rot@=wilted"
          ],
          "delay_s": 259200,
          "tuned": false
        }
      },
      "offers": {
        "discard": {
          "label": "상한 음식을 버린다",
          "verb": "discard",
          "needs": [
            {
              "aware": "OBJ000001|body:rot",
              "at_least": "understood"
            }
          ],
          "when": [
            "OBJ000001|body:rot@>=spoiled"
          ],
          "effect": [
            "OBJ000001|body:rot@=gone",
            "OBJ000001|body:smell@=gone"
          ],
          "minutes": 2,
          "tuned": false
        }
      },
      "desc": [
        "음식의 종류. 직접 두지 않고 개별 음식이 물려받는다. 기본은 뚜껑을 딴 냉장 음식(우유 기준)."
      ]
    },
